<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/bg_grouped">
  <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
    <ScrollView android:id="@+id/pageHome" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="0dp" android:fillViewport="true">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/app_name" android:textSize="32sp" android:textColor="@color/text_primary" android:textStyle="bold" android:layout_marginTop="12dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_subtitle" android:textSize="16sp" android:textColor="@color/text_secondary" android:id="@+id/homeSubtitle" android:layout_marginTop="8dp" android:layout_marginBottom="28dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_home_hero" android:padding="24dp">
          <ImageView android:layout_width="64dp" android:layout_height="64dp" android:src="@drawable/ic_tab_home" android:tint="@color/white" android:importantForAccessibility="no" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_protection" android:textSize="24sp" android:textColor="@color/white" android:textStyle="bold" android:layout_marginTop="20dp" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/status_not_owner" android:textSize="15sp" android:textColor="@color/white" android:id="@+id/homeStatus" android:layout_marginTop="12dp" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_quick_access" android:textSize="13sp" android:textColor="@color/text_secondary" android:textStyle="bold" android:layout_marginTop="28dp" android:layout_marginBottom="12dp" />
        <LinearLayout android:id="@+id/homeOpenStore" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/bg_glass_card" android:foreground="?attr/selectableItemBackground" android:padding="20dp" android:layout_marginBottom="12dp" android:clickable="true" android:focusable="true" android:minimumHeight="88dp">
          <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_tab_store" android:tint="@color/accent_blue" android:layout_marginEnd="16dp" android:importantForAccessibility="no" />
          <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/tab_store" android:textSize="18sp" android:textColor="@color/text_primary" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_store_description" android:textSize="14sp" android:textColor="@color/text_secondary" android:layout_marginTop="4dp" />
          </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/homeOpenSettings" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/bg_glass_card" android:foreground="?attr/selectableItemBackground" android:padding="20dp" android:layout_marginBottom="12dp" android:clickable="true" android:focusable="true" android:minimumHeight="88dp">
          <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_tab_settings" android:tint="@color/accent_blue" android:layout_marginEnd="16dp" android:importantForAccessibility="no" />
          <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/tab_settings" android:textSize="18sp" android:textColor="@color/text_primary" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_settings_description" android:textSize="14sp" android:textColor="@color/text_secondary" android:layout_marginTop="4dp" />
          </LinearLayout>
        </LinearLayout>
      </LinearLayout>
    </ScrollView>
    <LinearLayout android:id="@+id/pageStore" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:visibility="gone">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/tab_store" android:textSize="28sp" android:textStyle="bold" android:textColor="@color/text_primary" android:padding="24dp" />
      <ProgressBar android:id="@+id/storeProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:max="100" />
      <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:padding="10dp">
        <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_glass_card" android:padding="4dp" android:clipToOutline="true">
          <WebView android:id="@+id/storeWebView" android:layout_width="match_parent" android:layout_height="match_parent" />
        </FrameLayout>
      </FrameLayout>
    </LinearLayout>
    <ScrollView android:id="@+id/pageSettings" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView style="@style/Text.LargeTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:layout_marginBottom="16dp" android:textColor="@color/text_primary" android:text="@string/settings_title" />
        <TextView android:id="@+id/statusBanner" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_status_warning" android:textColor="@color/status_warning_text" android:textStyle="bold" android:textSize="14sp" android:padding="16dp" android:layout_marginBottom="20dp" android:text="@string/status_not_owner" />
        <TextView style="@style/Text.SectionHeader" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingBottom="8dp" android:textColor="@color/text_secondary" android:text="@string/settings_language" />
        <LinearLayout android:id="@+id/languageRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:background="@drawable/bg_glass_card" android:padding="12dp" android:layout_marginBottom="20dp" />
        <TextView android:id="@+id/rowUpdates" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.Body" android:background="@drawable/bg_glass_card" android:padding="16dp" android:text="@string/settings_check_updates" android:textColor="@color/accent_navy" android:textStyle="bold" android:clickable="true" android:focusable="true" />
      </LinearLayout>
    </ScrollView>
    <ScrollView android:id="@+id/pageAbout" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView style="@style/Text.LargeTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:layout_marginBottom="16dp" android:textColor="@color/text_primary" android:text="@string/about_title" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_glass_card" android:padding="18dp">
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.Body" android:text="@string/about_filter_info" />
          <TextView android:id="@+id/versionLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textColor="@color/text_secondary" android:text="YiDream" />
          <TextView android:id="@+id/contactLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/accent_blue" android:autoLink="email" android:text="yiddishdream@gmail.com" />
        </LinearLayout>
        <TextView android:id="@+id/rowRemoveFilter" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.Body" android:background="@drawable/bg_glass_card" android:padding="16dp" android:layout_marginTop="16dp" android:text="@string/about_remove_filter" android:textColor="@color/danger" android:textStyle="bold" android:clickable="true" android:focusable="true" />
      </LinearLayout>
    </ScrollView>
  </FrameLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:background="@drawable/bg_glass_bar" android:paddingVertical="12dp">
    <LinearLayout android:id="@+id/tabHome" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true" android:paddingVertical="10dp" android:background="?attr/selectableItemBackground" android:layout_marginHorizontal="3dp">
      <ImageView android:id="@+id/tabHomeIcon" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_tab_home" />
      <TextView android:id="@+id/tabHomeLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tab_home" android:textSize="11sp" android:textColor="@color/accent_navy" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:id="@+id/tabStore" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true" android:paddingVertical="10dp" android:background="?attr/selectableItemBackground" android:layout_marginHorizontal="3dp">
      <ImageView android:id="@+id/tabStoreIcon" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_tab_store" />
      <TextView android:id="@+id/tabStoreLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tab_store" android:textSize="11sp" android:textColor="@color/accent_navy" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:id="@+id/tabSettings" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true" android:paddingVertical="10dp" android:background="?attr/selectableItemBackground" android:layout_marginHorizontal="3dp">
      <ImageView android:id="@+id/tabSettingsIcon" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_tab_settings" />
      <TextView android:id="@+id/tabSettingsLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tab_settings" android:textSize="11sp" android:textColor="@color/accent_navy" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:id="@+id/tabAbout" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true" android:paddingVertical="10dp" android:background="?attr/selectableItemBackground" android:layout_marginHorizontal="3dp">
      <ImageView android:id="@+id/tabAboutIcon" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_tab_about" />
      <TextView android:id="@+id/tabAboutLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tab_about" android:textSize="11sp" android:textColor="@color/accent_navy" android:textStyle="bold" />
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
