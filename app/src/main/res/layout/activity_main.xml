<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/bg_app_gradient">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="20dp" android:paddingEnd="24dp" android:paddingTop="12dp" android:paddingBottom="8dp">
    <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@mipmap/ic_launcher" android:importantForAccessibility="no" />
    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/app_name" android:textSize="19sp" android:textStyle="bold" android:letterSpacing="-0.04" android:textColor="@color/accent_navy" android:layout_marginStart="6dp" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_brand_caption" android:textSize="9sp" android:letterSpacing="0.12" android:textColor="@color/text_secondary" android:textStyle="bold" />
  </LinearLayout>
  <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
    <ScrollView android:id="@+id/pageHome" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false" android:scrollbars="none">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="20dp" android:paddingBottom="16dp">
        <TextView style="@style/Text.LargeTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_home_title" android:textColor="@color/accent_navy" />
        <TextView style="@style/Text.LargeTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_home_accent" android:textColor="@color/accent_blue" />
        <TextView android:id="@+id/homeSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_subtitle" android:textSize="14sp" android:textColor="@color/text_secondary" android:lineSpacingExtra="3dp" android:layout_marginTop="12dp" android:layout_marginBottom="24dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_protection_card" android:padding="20dp">
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/ic_shield" android:tint="@color/accent_blue" android:importantForAccessibility="no" android:layout_marginEnd="12dp" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/home_protection" android:textSize="17sp" android:textColor="@color/accent_navy" android:textStyle="bold" />
          </LinearLayout>
          <TextView android:id="@+id/homeStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/status_not_owner" android:textSize="13sp" android:textColor="@color/text_secondary" android:lineSpacingExtra="3dp" android:layout_marginTop="14dp" />
        </LinearLayout>
        <TextView style="@style/Text.SectionHeader" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_quick_access" android:textSize="10sp" android:layout_marginTop="28dp" android:layout_marginBottom="12dp" />
        <LinearLayout android:id="@+id/homeOpenStore" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/bg_quick_action" android:foreground="?attr/selectableItemBackground" android:padding="16dp" android:layout_marginBottom="12dp" android:clickable="true" android:focusable="true" android:minHeight="88dp">
          <ImageView android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:background="@drawable/ui_icon_tile" android:src="@drawable/ic_tab_store" android:tint="@color/accent_blue" android:layout_marginEnd="14dp" android:importantForAccessibility="no" />
          <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/tab_store" android:textSize="16sp" android:textColor="@color/text_primary" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_store_description" android:textSize="12sp" android:textColor="@color/text_secondary" android:lineSpacingExtra="2dp" android:layout_marginTop="4dp" />
          </LinearLayout>
          <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_marginStart="8dp" android:src="@drawable/ic_chevron" android:tint="@color/text_tertiary" android:importantForAccessibility="no" />
        </LinearLayout>
        <LinearLayout android:id="@+id/homeOpenSites" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/bg_quick_action" android:foreground="?attr/selectableItemBackground" android:padding="16dp" android:layout_marginBottom="12dp" android:clickable="true" android:focusable="true" android:minHeight="88dp">
          <ImageView android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:background="@drawable/ui_icon_tile" android:src="@drawable/ic_tab_sites" android:tint="@color/accent_blue" android:layout_marginEnd="14dp" android:importantForAccessibility="no" />
          <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/mdm_new_request" android:textSize="16sp" android:textColor="@color/text_primary" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/mdm_site_shortcut" android:textSize="12sp" android:textColor="@color/text_secondary" android:lineSpacingExtra="2dp" android:layout_marginTop="4dp" />
          </LinearLayout>
          <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_marginStart="8dp" android:src="@drawable/ic_chevron" android:tint="@color/text_tertiary" android:importantForAccessibility="no" />
        </LinearLayout>
        <LinearLayout android:id="@+id/homeOpenSettings" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/bg_quick_action" android:foreground="?attr/selectableItemBackground" android:padding="16dp" android:layout_marginBottom="12dp" android:clickable="true" android:focusable="true" android:minHeight="88dp">
          <ImageView android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:background="@drawable/ui_icon_tile" android:src="@drawable/ic_tab_settings" android:tint="@color/accent_blue" android:layout_marginEnd="14dp" android:importantForAccessibility="no" />
          <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/tab_settings" android:textSize="16sp" android:textColor="@color/text_primary" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_settings_description" android:textSize="12sp" android:textColor="@color/text_secondary" android:lineSpacingExtra="2dp" android:layout_marginTop="4dp" />
          </LinearLayout>
          <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_marginStart="8dp" android:src="@drawable/ic_chevron" android:tint="@color/text_tertiary" android:importantForAccessibility="no" />
        </LinearLayout>
      </LinearLayout>
    </ScrollView>
    <LinearLayout android:id="@+id/pageStore" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:visibility="gone">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="22dp" android:paddingEnd="22dp" android:paddingTop="20dp" android:paddingBottom="6dp">
        <TextView style="@style/Text.SectionHeader" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_store_eyebrow" android:textSize="10sp" android:textColor="@color/accent_blue" android:layout_marginBottom="7dp" />
        <TextView style="@style/Text.LargeTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/tab_store" android:textColor="@color/accent_navy" android:textSize="32sp" />
      </LinearLayout>
      <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:scrollbars="none">
        <LinearLayout android:id="@+id/storeContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="12dp" android:paddingBottom="20dp" />
      </ScrollView>
    </LinearLayout>
    <ScrollView android:id="@+id/pageSettings" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:scrollbars="none">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="20dp" android:paddingBottom="24dp">
        <TextView style="@style/Text.LargeTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/accent_navy" android:text="@string/settings_title" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_settings_subtitle" android:textSize="14sp" android:textColor="@color/text_secondary" android:layout_marginTop="8dp" android:layout_marginBottom="22dp" />
        <TextView android:id="@+id/statusBanner" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_status_warning" android:textColor="@color/status_warning_text" android:textStyle="bold" android:textSize="12sp" android:padding="16dp" android:lineSpacingExtra="2dp" android:layout_marginBottom="24dp" android:text="@string/status_not_owner" />
        <TextView style="@style/Text.SectionHeader" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:text="@string/settings_language" android:textSize="10sp" />
        <LinearLayout android:id="@+id/languageRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:background="@drawable/bg_glass_card" android:padding="6dp" android:layout_marginBottom="26dp" />
        <TextView style="@style/Text.SectionHeader" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_connection_section" android:layout_marginBottom="12dp" android:textSize="10sp" />
        <LinearLayout android:id="@+id/rowUpdates" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/bg_quick_action" android:foreground="?attr/selectableItemBackground" android:padding="16dp" android:layout_marginBottom="12dp" android:clickable="true" android:focusable="true" android:minHeight="88dp">
          <ImageView android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:background="@drawable/ui_icon_tile" android:src="@drawable/ui_ic_refresh" android:tint="@color/accent_blue" android:layout_marginEnd="14dp" android:importantForAccessibility="no" />
          <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_check_updates" android:textSize="16sp" android:textColor="@color/text_primary" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_updates_caption" android:textSize="12sp" android:textColor="@color/text_secondary" android:lineSpacingExtra="2dp" android:layout_marginTop="4dp" />
          </LinearLayout>
          <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_marginStart="8dp" android:src="@drawable/ic_chevron" android:tint="@color/text_tertiary" android:importantForAccessibility="no" />
        </LinearLayout>
        <LinearLayout android:id="@+id/rowPairDevice" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/bg_quick_action" android:foreground="?attr/selectableItemBackground" android:padding="16dp" android:layout_marginBottom="12dp" android:clickable="true" android:focusable="true" android:minHeight="88dp">
          <ImageView android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:background="@drawable/ui_icon_tile" android:src="@drawable/ui_ic_link" android:tint="@color/accent_blue" android:layout_marginEnd="14dp" android:importantForAccessibility="no" />
          <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/mdm_pair" android:textSize="16sp" android:textColor="@color/text_primary" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_pair_caption" android:textSize="12sp" android:textColor="@color/text_secondary" android:lineSpacingExtra="2dp" android:layout_marginTop="4dp" />
          </LinearLayout>
          <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_marginStart="8dp" android:src="@drawable/ic_chevron" android:tint="@color/text_tertiary" android:importantForAccessibility="no" />
        </LinearLayout>
        <LinearLayout android:id="@+id/sectionAbout" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="16dp">
          <TextView style="@style/Text.SectionHeader" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="@string/about_title" android:textSize="10sp" />
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_glass_card" android:padding="20dp">
            <TextView style="@style/Text.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/about_filter_info" android:textSize="13sp" android:lineSpacingExtra="4dp" android:textColor="@color/text_secondary" />
            <TextView android:id="@+id/versionLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:textColor="@color/accent_navy" android:textStyle="bold" android:textSize="13sp" android:text="YiDream" />
            <TextView android:id="@+id/contactLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/accent_blue" android:textColorLink="@color/accent_blue" android:autoLink="email" android:textSize="13sp" android:text="yiddishdream@gmail.com" android:minHeight="40dp" android:gravity="center_vertical" />
          </LinearLayout>
          <TextView android:id="@+id/rowRemoveFilter" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.Body" android:background="@drawable/ui_danger_row" android:foreground="?attr/selectableItemBackground" android:padding="18dp" android:layout_marginTop="16dp" android:text="@string/about_remove_filter" android:textColor="@color/danger" android:textStyle="bold" android:textSize="13sp" android:clickable="true" android:focusable="true" android:minHeight="56dp" />
        </LinearLayout>
      </LinearLayout>
    </ScrollView>
    <ScrollView android:id="@+id/pageSites" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:scrollbars="none">
      <LinearLayout android:id="@+id/sitesContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="20dp" android:paddingBottom="24dp" />
    </ScrollView>
  </FrameLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:background="@drawable/bg_navigation" android:layout_marginHorizontal="14dp" android:layout_marginBottom="12dp" android:layout_marginTop="5dp" android:padding="6dp" android:elevation="3dp">
    <LinearLayout android:id="@+id/tabHome" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true" android:paddingVertical="8dp" android:background="@drawable/bg_nav_item" android:layout_marginHorizontal="2dp" android:minHeight="58dp">
      <ImageView android:id="@+id/tabHomeIcon" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_tab_home" android:importantForAccessibility="no" />
      <TextView android:id="@+id/tabHomeLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tab_home" android:textSize="10sp" android:textColor="@color/accent_navy" android:textStyle="bold" android:layout_marginTop="5dp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/tabStore" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true" android:paddingVertical="8dp" android:background="@drawable/bg_nav_item" android:layout_marginHorizontal="2dp" android:minHeight="58dp">
      <ImageView android:id="@+id/tabStoreIcon" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_tab_store" android:importantForAccessibility="no" />
      <TextView android:id="@+id/tabStoreLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tab_store" android:textSize="10sp" android:textColor="@color/accent_navy" android:textStyle="bold" android:layout_marginTop="5dp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/tabSites" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true" android:paddingVertical="8dp" android:background="@drawable/bg_nav_item" android:layout_marginHorizontal="2dp" android:minHeight="58dp">
      <ImageView android:id="@+id/tabSitesIcon" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_tab_sites" android:importantForAccessibility="no" />
      <TextView android:id="@+id/tabSitesLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/mdm_sites" android:textSize="10sp" android:textColor="@color/accent_navy" android:textStyle="bold" android:layout_marginTop="5dp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/tabSettings" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true" android:paddingVertical="8dp" android:background="@drawable/bg_nav_item" android:layout_marginHorizontal="2dp" android:minHeight="58dp">
      <ImageView android:id="@+id/tabSettingsIcon" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_tab_settings" android:importantForAccessibility="no" />
      <TextView android:id="@+id/tabSettingsLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tab_settings" android:textSize="10sp" android:textColor="@color/accent_navy" android:textStyle="bold" android:layout_marginTop="5dp" />
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
