<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Ombre douce sous le panneau, pour la sensation de flottement -->
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_shadow" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <!-- Remplissage translucide façon verre dépoli -->
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_fill" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="@color/glass_border" />
        </shape>
    </item>
</layer-list>
